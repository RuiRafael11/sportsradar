NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DBNAME?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=1d
CORS_ORIGIN=http://localhost:19006,http://localhost:8081

STRIPE_SECRET_KEY=replace_with_stripe_secret_key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
REQUIRE_PAYMENT_FOR_BOOKINGS=true

GOOGLE_PLACES_KEY=replace_me
ADMIN_API_KEY=replace_me

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace_me
MAIL_PASS=replace_me
